# PocketBase configuration. `pb/.env` is git-ignored: never commit real values.
# Generate it from Ansible Vault (the app password is stored there, encrypted):
#   cd ansible && ansible-playbook playbooks/pb-env-local.yml --ask-vault-pass
# or copy this file to `pb/.env` and fill it in by hand.
#
# In development, `pb/dev.sh` loads this file but still sends every email to
# Mailpit (http://127.0.0.1:8025). Run `PB_DEV_REAL_SMTP=1 ./pb/dev.sh` to
# send real emails through Gmail instead.

# ── Email (Gmail) ────────────────────────────────────────────────────────────
# PB_SMTP_PASS is a Gmail *app password* (16 letters), not the account
# password: https://myaccount.google.com/apppasswords (needs 2-Step Verification).
PB_SMTP_HOST=smtp.gmail.com
PB_SMTP_PORT=587
PB_SMTP_USER=familias.diego.velazquez@gmail.com
PB_SMTP_PASS=
# Sender of every email (login codes, notices to authors).
PB_SENDER=familias.diego.velazquez@gmail.com
# Where moderation notices go (new stories, comments and proposals).
PB_AVISOS=familias.diego.velazquez@gmail.com

# ── URLs ─────────────────────────────────────────────────────────────────────
# Public site: links in emails and the app URL PocketBase uses.
PB_APP_URL=https://familiasdiegovelazquez.es
PB_WEB_URL=https://familiasdiegovelazquez.es
# PocketBase itself: links to the admin panel (/_/) in moderation emails.
# In production the panel is reached through an SSH tunnel.
PB_PUBLIC_URL=http://127.0.0.1:8090
