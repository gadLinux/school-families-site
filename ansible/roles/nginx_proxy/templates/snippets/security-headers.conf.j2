# {{ ansible_managed }}
# Se incluye en cada location que use add_header (nginx no hereda add_header
# del nivel superior si la location define alguno propio).
add_header Strict-Transport-Security "max-age=31536000" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;
{% set analitica = (matomo_url | regex_replace('/+$', '')) if matomo_url else '' %}
{% set extra = (' ' ~ analitica) if analitica else '' %}
add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:{{ extra }}; connect-src 'self'{{ extra }}; style-src 'self' 'unsafe-inline'; script-src 'self'{{ extra }}; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
