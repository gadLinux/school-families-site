# {{ ansible_managed }}
# Reenvío al contenedor de la otra web (solo escucha en localhost).
proxy_pass http://{{ otra_web_http_bind }};
proxy_http_version 1.1;
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_read_timeout {{ otra_web_proxy_read_timeout }};
proxy_send_timeout {{ otra_web_proxy_read_timeout }};
