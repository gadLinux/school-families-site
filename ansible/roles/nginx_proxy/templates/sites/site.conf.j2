# {{ ansible_managed }}
# {{ site_domain }} — web estática (Astro) servida desde {{ site_root }}/current

server {
    listen 80;
    listen [::]:80;
    server_name {{ ([site_domain] + site_aliases) | join(' ') }};

    include snippets/acme-challenge.conf;

{% if site_cert_ready | bool %}
    location / {
        return 301 https://{{ site_domain }}$request_uri;
    }
{% else %}
    # Aún sin certificado: se sirve por HTTP hasta que certbot lo emita.
    root {{ site_root }}/current;
    error_page 404 /404.html;
    location / {
        try_files $uri $uri/ =404;
    }

    # Backend de participación (PocketBase, solo en localhost). El panel (/_/)
    # no se expone: se abre por túnel SSH (ssh -L 8090:127.0.0.1:8090 …).
    location /api/ {
        proxy_pass http://{{ pb_listen }};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Hasta 10 adjuntos de 5 MB por experiencia.
        client_max_body_size 60m;
        proxy_read_timeout 120s;
    }
{% endif %}
}
{% if site_cert_ready | bool %}

{% for alias in site_aliases %}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ alias }};

    ssl_certificate     {{ letsencrypt_dir }}/live/{{ site_domain }}/fullchain.pem;
    ssl_certificate_key {{ letsencrypt_dir }}/live/{{ site_domain }}/privkey.pem;
    include snippets/ssl-params.conf;

    return 301 https://{{ site_domain }}$request_uri;
}

{% endfor %}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ site_domain }};

    ssl_certificate     {{ letsencrypt_dir }}/live/{{ site_domain }}/fullchain.pem;
    ssl_certificate_key {{ letsencrypt_dir }}/live/{{ site_domain }}/privkey.pem;
    include snippets/ssl-params.conf;

    root {{ site_root }}/current;
    index index.html;
    error_page 404 /404.html;

    access_log /var/log/nginx/{{ site_domain }}.access.log;
    error_log  /var/log/nginx/{{ site_domain }}.error.log;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;

    # Recursos con hash en el nombre: caché de un año.
    location /_astro/ {
        include snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        include snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ =404;
    }

    # Backend de participación (PocketBase, solo en localhost). El panel (/_/)
    # no se expone: se abre por túnel SSH (ssh -L 8090:127.0.0.1:8090 …).
    location /api/ {
        proxy_pass http://{{ pb_listen }};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Hasta 10 adjuntos de 5 MB por experiencia.
        client_max_body_size 60m;
        proxy_read_timeout 120s;
    }
}
{% endif %}
