---
/**
 * Líneas en SVG, generadas en compilación. Cuando el eje no empieza en 0 se
 * dibujan sus marcas y se avisa debajo, para que el recorte no engañe.
 * Se etiqueta el último valor de cada serie (el más reciente) y los puntos que
 * se pidan en `destacar`. La tabla completa va aparte, en el bloque.
 */
export interface SerieLineas {
  nombre: string;
  color: string;
  valores: (number | null)[];
  /** Trazo discontinuo, para distinguir una serie sin depender del color. */
  discontinua?: boolean;
  /** false: sin etiqueta de valor (p. ej., un tramo que acaba a mitad del eje). */
  etiquetar?: boolean;
}

interface Props {
  id: string;
  titulo: string;
  categorias: string[];
  series: SerieLineas[];
  min: number;
  max: number;
  marcas: number[];
  /** Índices de categoría cuyo valor se etiqueta además de los extremos. */
  destacar?: number[];
  formato?: (v: number) => string;
}

const {
  id,
  titulo,
  categorias,
  series,
  min,
  max,
  marcas,
  destacar = [],
  formato = (v: number) => String(v),
} = Astro.props;

const ancho = 640;
const alto = 320;
const margen = { arriba: 24, abajo: 40, izq: 40, der: 76 };
const x = (i: number) =>
  margen.izq + (i * (ancho - margen.izq - margen.der)) / Math.max(1, categorias.length - 1);
const y = (v: number) => margen.arriba + (alto - margen.arriba - margen.abajo) * (1 - (v - min) / (max - min));

/** Con muchos cursos se muestra una etiqueta del eje X de cada dos, contando desde el último. */
const paso = categorias.length > 8 ? 2 : 1;

function trazo(valores: (number | null)[]): string {
  return valores
    .map((v, i) => (v === null ? null : `${x(i).toFixed(1)},${y(v).toFixed(1)}`))
    .filter(Boolean)
    .join(' ');
}

/** Primera serie: etiquetas encima; segunda: debajo, para que no se pisen. */
function etiquetas(s: SerieLineas, orden: number) {
  if (s.etiquetar === false) return [];
  const indices = s.valores.map((v, i) => (v === null ? -1 : i)).filter((i) => i >= 0);
  const mostrar = new Set([indices[indices.length - 1], ...destacar]);
  return [...mostrar]
    .filter((i) => s.valores[i] !== null && s.valores[i] !== undefined)
    .map((i) => ({ i, v: s.valores[i] as number, dy: orden === 0 ? -10 : 20 }));
}
---

<svg class="grafico" viewBox={`0 0 ${ancho} ${alto}`} role="img" aria-labelledby={`${id}-t`}>
  <title id={`${id}-t`}>{titulo}</title>
  {
    marcas.map((m) => (
      <g>
        <line class="grafico__rejilla" x1={margen.izq} x2={ancho - margen.der} y1={y(m)} y2={y(m)} />
        <text class="grafico__eje" x={margen.izq - 6} y={y(m) + 4} text-anchor="end">
          {m}
        </text>
      </g>
    ))
  }
  {
    categorias.map((c, i) =>
      (categorias.length - 1 - i) % paso === 0 ? (
        <text class="grafico__eje" x={x(i)} y={alto - 14} text-anchor="middle">
          {c}
        </text>
      ) : null,
    )
  }
  {
    series.map((s, orden) => (
      <g>
        <polyline points={trazo(s.valores)} fill="none" stroke={s.color} stroke-width="3" stroke-linejoin="round" stroke-dasharray={s.discontinua ? '8 6' : undefined} />
        {s.valores.map((v, i) => (v === null ? null : <circle cx={x(i)} cy={y(v)} r="4" fill={s.color} />))}
        {etiquetas(s, orden).map(({ i, v, dy }) => (
          <text class="grafico__valor" x={x(i) + 6} y={y(v) + dy} text-anchor="start" style={`fill: color-mix(in srgb, ${s.color} 60%, black)`}>
            {formato(v)}
          </text>
        ))}
      </g>
    ))
  }
</svg>

<style>
  .grafico {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-body);
  }
  .grafico__rejilla {
    stroke: var(--border);
    stroke-width: 1;
  }
  .grafico__eje {
    font-size: 13px;
    fill: var(--muted);
  }
  .grafico__valor {
    font-size: 14px;
    font-weight: 700;
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
  }
  @media (max-width: 599px) {
    .grafico__eje {
      font-size: 20px;
    }
    .grafico__valor {
      font-size: 22px;
    }
  }
</style>
