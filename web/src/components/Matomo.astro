---
// Estadísticas de visitas (ver lib/estadisticas.ts). Va como script externo
// por la CSP (script-src 'self').
---

<script>
  import { iniciarEstadisticas } from '../lib/estadisticas';

  // Las páginas con data-visita-manual (p. ej. una experiencia, cuyo título
  // llega del servidor) llaman a registrarVisita() cuando lo tienen.
  iniciarEstadisticas(!('visitaManual' in document.body.dataset));
</script>
