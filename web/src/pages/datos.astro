            nombre: a.nombre,
            color: a.color,
            discontinua: a.discontinua,
            valores: edades.map((e) => Number(idoDe(a.ambito)[`idoneidad_${e}_pct`])),
          }))}
          min={70}
          max={100}
          marcas={[70, 80, 90, 100]}
          formato={(v) => pct(v)}
        />
        <table slot="tabla">
          <thead>
            <tr><th>Edad</th>{ambitosIdo.map((a) => <th>{a.nombre}</th>)}</tr>
          </thead>
          <tbody>
            {edades.map((e) => (
              <tr><td>{e} años</td>{ambitosIdo.map((a) => <td>{pct(Number(idoDe(a.ambito)[`idoneidad_${e}_pct`]))}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </BloqueDato>
      <BloqueDato
        id="titulacion-eso"
        titulo="Alumnos que obtienen el título de ESO"
        cifra={pct(Number(notaUlt.titulacion_eso_centro_pct), 2)}
        cifraTexto={`titula en ESO en ${notaUlt.curso_academico} (${pct(Number(notaUlt.titulacion_eso_cm_pct), 2)} en la Comunidad de Madrid)`}
        descripcion={`En los ${resultadosCm.length} cursos publicados, el porcentaje de alumnos que obtiene el título de ESO en el centro está por encima de la media de la Comunidad de Madrid, entre ${dec(Math.min(...difEso))} y ${dec(Math.max(...difEso))} puntos.`}
        pregunta="¿Cómo encaja una titulación en ESO tan alta con lo que ocurre después en Bachillerato?"
        leyenda={[
          { nombre: 'IES Diego Velázquez', color: CENTRO },
          { nombre: 'Comunidad de Madrid', color: CM },
        ]}
        notas={['El eje empieza en el 80 %, no en el 0 %, para que se vean las diferencias.']}
        citas={[{ fuente: 'F011' }]}
        csv={['f011_resultados_centro_vs_cm.csv']}
      >
        <Lineas
          id="g-titulacion-eso"
          titulo="Porcentaje de alumnos que obtienen el título de ESO, IES Diego Velázquez frente a Comunidad de Madrid"
          categorias={resultadosCm.map((r) => corto(r.curso_academico))}
          series={[
            { nombre: 'IES Diego Velázquez', color: CENTRO, valores: resultadosCm.map((r) => Number(r.titulacion_eso_centro_pct)) },
            { nombre: 'Comunidad de Madrid', color: CM, valores: resultadosCm.map((r) => Number(r.titulacion_eso_cm_pct)) },
          ]}
          min={80}
          max={100}
          marcas={[80, 85, 90, 95, 100]}
          formato={(v) => pct(v)}
        />
        <table slot="tabla">
          <thead>
            <tr><th>Curso</th><th>Centro</th><th>Com. de Madrid</th><th>Diferencia</th></tr>
          </thead>
          <tbody>
            {resultadosCm.map((r) => (
              <tr>
                <td>{r.curso_academico}</td>
                <td>{pct(Number(r.titulacion_eso_centro_pct), 2)}</td>
                <td>{pct(Number(r.titulacion_eso_cm_pct), 2)}</td>
                <td>{dec(Number(r.titulacion_eso_centro_pct) - Number(r.titulacion_eso_cm_pct), 2)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </BloqueDato>
    </div>
  </section>

  <section class="container seccion" id="grupos" aria-labelledby="grupos-h">
    <h2 id="grupos-h">2.º de ESO, grupo a grupo</h2>
    <p class="seccion__intro">
      Resultados de cada grupo de 2.º de ESO en 2025-26, tomados de las actas de evaluación que recopiló el propio
      centro. Son datos agregados: no contienen información de alumnos concretos.
    </p>

    <div class="rejilla">
      <BloqueDato
        id="grupos-eso"
        alerta={`Al final de curso, el porcentaje de alumnos con alguna materia suspensa va del ${pct(Math.min(...negFinal))} en 2.º A y 2.º B al ${pct(Math.max(...negFinal))} en 2.º C y 2.º F. Pero los grupos no se forman igual: 2.º A y 2.º B reúnen a la sección de francés.`}
        titulo="Alumnos con alguna materia suspensa, por grupo de 2.º ESO"
        cifra={`${dec(Math.min(...negFinal))}–${pct(Math.max(...negFinal))}`}
        cifraTexto="al final de curso, según el grupo (2025-26)"
        descripcion="El porcentaje de alumnos con alguna materia suspensa varía mucho de un grupo a otro en las tres evaluaciones. Según las actas, todo el alumnado de 2.º A y 2.º B estudia francés como segunda lengua y ninguno cursa Refuerzo de Matemáticas. En 2.º C a 2.º F conviven Inglés e Inglés Avanzado, y hay alumnos con Refuerzo de Matemáticas."
        pregunta="¿Con qué criterio se reparten los alumnos entre grupos? ¿Reciben más apoyo los grupos con más suspensos?"
        leyenda={[
          { nombre: '1.ª evaluación', color: GRIS_CLARO },
          { nombre: '2.ª evaluación', color: GRIS },
          { nombre: 'Evaluación final', color: CENTRO },
        ]}
        notas={['Cada grupo tiene entre 20 y 26 alumnos, así que un alumno supone entre 4 y 5 puntos.', 'La composición de cada grupo (francés, Inglés Avanzado, Refuerzo de Matemáticas) está en la tabla del gráfico siguiente.']}
        citas={[
          { fuente: 'F008', pagina: '9-14', dato: '1.ª evaluación' },
          { fuente: 'F008', pagina: '15-20', dato: '2.ª evaluación' },
          { fuente: 'F008', pagina: '21-26', dato: 'Evaluación final' },
          { fuente: 'F008', pagina: '5 y 8', dato: 'Notas medias (tabla)' },
        ]}
        csv={['f008_evaluacion_negativa_por_grupo.csv', 'f008_medias_por_grupo.csv']}
      >
        <Barras
          id="g-grupos-eso"
          titulo="Porcentaje de alumnos con alguna materia suspensa por grupo de 2.º ESO, en la 1.ª, la 2.ª y la evaluación final, curso 2025-26"
          categorias={grupos.map(etiquetaGrupo)}
          series={[
            { nombre: '1.ª evaluación', color: GRIS_CLARO, valores: grupos.map((g) => valor(negativa, g, '1a', 'pct_evaluados_negativamente')) },
            { nombre: '2.ª evaluación', color: GRIS, valores: grupos.map((g) => valor(negativa, g, '2a', 'pct_evaluados_negativamente')) },
            { nombre: 'Final', color: CENTRO, valores: negFinal },
          ]}
          max={100}
          formato={(v) => `${Math.round(v)}%`}
        />
        <table slot="tabla">
          <thead>
            <tr><th>Grupo</th><th>1.ª ev.</th><th>2.ª ev.</th><th>Final</th><th>Nota media final</th></tr>
          </thead>
          <tbody>
            {grupos.map((g) => (
              <tr>
                <td>{etiquetaGrupo(g)}</td>
                <td>{pct(valor(negativa, g, '1a', 'pct_evaluados_negativamente') as number, 2)}</td>
                <td>{pct(valor(negativa, g, '2a', 'pct_evaluados_negativamente') as number, 2)}</td>
                <td>{pct(valor(negativa, g, 'final', 'pct_evaluados_negativamente') as number, 2)}</td>
                <td>{(valor(medias, g, 'final', 'media') as number).toLocaleString('es-ES', { minimumFractionDigits: 1 })}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </BloqueDato>

      <BloqueDato
        id="materias-grupo"
        titulo="Suspensos por materia y grupo en 2.º de ESO"
        cifra={`${pct(Math.max(...materias.map((r) => pctMateria(r, 'in_matematicas'))))}`}
        cifraTexto="de suspensos en Matemáticas en el grupo con más, al final de 2025-26"
        descripcion="Cada casilla es el porcentaje de alumnos del grupo con insuficiente en esa materia en la evaluación final (junio de 2026). Cuanto más oscura, más suspensos. Matemáticas y Física y Química concentran los suspensos, sobre todo en 2.º E y 2.º F."
        pregunta="¿Por qué Matemáticas y Física y Química suspenden tanto más en unos grupos que en otros?"
        leyenda={[{ nombre: 'Más oscuro = más suspensos (el valor va en cada casilla)', color: CENTRO }]}
        notas={[
          'Cada grupo tiene entre 20 y 26 alumnos: un alumno supone entre 4 y 5 puntos.',
          'En Inglés se suman «Inglés» e «Inglés Avanzado».',
        ]}
        citas={[{ fuente: 'F008', pagina: '21-26', dato: 'Actas de la evaluación final de cada grupo' }]}
        csv={['f008_final_materias_y_composicion_2eso.csv']}
      >
        <Calor
          id="g-materias-grupo"
          titulo="Porcentaje de alumnos con insuficiente por materia y grupo de 2.º ESO en la evaluación final de 2025-26"
          filas={materias.map((r) => etiquetaGrupo(r.grupo))}
          columnas={columnasMaterias.map((c) => c.nombre)}
          valores={materias.map((r) => columnasMaterias.map((c) => pctMateria(r, c.campo)))}
          max={40}
          formato={(v) => `${Math.round(v)}%`}
        />
        <table slot="tabla">
          <thead>
            <tr>
              <th>Grupo</th><th>Alumnos</th>{columnasMaterias.map((c) => <th>{c.nombre} (IN)</th>)}
              <th>Francés 2.ª lengua</th><th>Inglés Avanzado</th><th>Refuerzo de Matemáticas</th>
            </tr>
          </thead>
          <tbody>
            {materias.map((r) => (
              <tr>
                <td>{etiquetaGrupo(r.grupo)}</td><td>{r.total_alumnos}</td>
                {columnasMaterias.map((c) => <td>{r[c.campo]}</td>)}
                <td>{r.alumnos_frances_2a_lengua}</td><td>{r.alumnos_ingles_avanzado}</td><td>{r.alumnos_refuerzo_matematicas}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </BloqueDato>
    </div>
  </section>

  <section class="container seccion" id="pendiente" aria-labelledby="pendiente-h">
    <h2 id="pendiente-h">Datos que todavía no son públicos</h2>
    <p class="seccion__intro">
      Algunas preguntas no se pueden responder con los datos publicados. Cuando estén disponibles, se
      añadirán aquí con su fuente.
    </p>
    <h3 class="pendientes__tema">Bachillerato y PAU</h3>
    <ul class="pendientes">
      <li>
        <strong>Alumnos matriculados en 1.º y en 2.º de Bachillerato, y titulados en la evaluación extraordinaria.</strong>{' '}
        Permitiría pasar de los mínimos calculados a las cifras exactas, y saber cuántos se presentaron a la
        PAU de julio.
      </li>
      <li>
        <strong>Qué cuenta cada cifra de aptos y de nota media.</strong> Si el centro incluye la convocatoria
        extraordinaria y a qué alumnos se refiere, para comparar con las cifras oficiales.
      </li>
    </ul>
    <h3 class="pendientes__tema">Promoción y repetición en la ESO</h3>
    <ul class="pendientes">
      <li>
        <strong>Continuidad entre cursos de la ESO.</strong> Cuántos alumnos siguen en el centro de 1.º a 4.º
        de ESO y cuántos repiten o se van.
      </li>
      <li>
        <strong>Promoción por curso en Madrid-Oeste.</strong> La Inspección envía a cada centro su promoción
        frente a la de su zona y su DAT, pero esas medias no están publicadas.
      </li>
      <li>
        <strong>Tasa de idoneidad del propio instituto</strong>, sin los demás centros del municipio.
      </li>
    </ul>
    <h3 class="pendientes__tema">Resultados por grupo</h3>
    <ul class="pendientes">
      <li>
        <strong>Resultados de 3.º y 4.º de ESO y de Bachillerato por grupo</strong>, como los que ya hay de
        2.º de ESO, y el criterio con que se forman los grupos.
      </li>
    </ul>
    <h3 class="pendientes__tema">Horas de clase y apoyos</h3>
    <ul class="pendientes">
      <li>
        <strong>Horas de clase sin profesor</strong> por grupo y cómo se cubren las guardias.
      </li>
      <li>
        <strong>Alumnado con necesidades de apoyo y medidas aplicadas</strong> (adaptaciones de exámenes,
        refuerzos, profesorado de apoyo), con datos agregados del centro. Las estadísticas oficiales solo las
        dan para toda la Comunidad.
      </li>
    </ul>
  </section>

  <Propuestas />
</Base>

