          min={80}
          max={100}
          marcas={[80, 85, 90, 95, 100]}
          formato={(v) => pct(v)}
        />
        <table slot="tabla">
          <thead>
            <tr><th>Curso</th><th>Centro</th><th>Com. de Madrid</th><th>Diferencia</th></tr>
