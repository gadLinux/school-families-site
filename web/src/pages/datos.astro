---
import Base from '../layouts/Base.astro';
import BloqueDato from '../components/graficos/BloqueDato.astro';
import Barras from '../components/graficos/Barras.astro';
import Lineas from '../components/graficos/Lineas.astro';
import Apiladas from '../components/graficos/Apiladas.astro';
import Calor from '../components/graficos/Calor.astro';
import Propuestas from '../components/Propuestas.astro';
import { dec, leerCsv, num, pct } from '../lib/csv';

const CENTRO = 'var(--accent)';
const CM = 'var(--compare)';
const GRIS = '#9aa1a8';
const GRIS_CLARO = '#d3d7db';
/** Tercera serie de contexto (DAT): gris oscuro y discontinua, para no confundirse con --compare. */
const GRIS_OSCURO = '#5b6670';
const CENTRO_CLARO = '#8cc2b5';

/** «2013-14» → «13-14», para que quepan todos los cursos en el eje. */
const corto = (curso: string) => curso.replace(/^20/, '').replace('/', '-');

// 1 · Quién llega a la PAU. La PAU exige el título de Bachiller (RD 534/2024,
// art. 10.1), así que presentados ≤ titulados. Con las cifras del centro salen
// mínimos sin estimar nada: alumnos ≥ P / T y no titulados ≥ P · (1 − T) / T.
const brecha = leerCsv('brecha_titulacion_pau.csv');
const acceso = brecha.map((r) => {
  const t = Number(r.titulados_bach_ordinaria_pct) / 100;
  const a = Number(r.aprobados_pau_pct) / 100;
  const presentados = Number(r.presentados_pau);
  return {
    convocatoria: `PAU ${Number(r.curso_academico.slice(0, 4)) + 1}`,
    tituladosPct: t * 100,
    aprobadosPct: a * 100,
    presentados,
    aprobados: Math.round(presentados * a),
    // Redondeo hacia abajo: el mínimo nunca se exagera.
    alumnosMin: Math.floor(presentados / t),
    noTitulan: Math.floor((presentados * (1 - t)) / t),
    aprobadosSobreTotalMax: a * t * 100,
  };
});

// 2 · Serie de aptos PAU, centro frente a la Comunidad de Madrid
const serie = leerCsv('serie_historica_aptos.csv');
const difs = serie.map((r) => Number(r.brecha_pp));
/** Último curso con media regional tomada del centro (F002); desde el siguiente, la oficial (F009). */
const ultimoCmCentro = serie.findLastIndex((r) => !r.fuente_cm.startsWith('F009'));

// 2b · Nota media PAU y titulación en ESO: buscador de centros de la CM (F011)
const resultadosCm = leerCsv('f011_resultados_centro_vs_cm.csv');
const notaUlt = resultadosCm[resultadosCm.length - 1];
const difNota = resultadosCm.map(
  (r) => Number(r.pau_media_fase_general_segun_centro_f002) - Number(r.pau_nota_media_centro),
);
const cursosNotaSobreCm = resultadosCm.filter((r) => Number(r.pau_nota_media_centro) > Number(r.pau_nota_media_cm)).length;
const difEso = resultadosCm.map((r) => Number(r.titulacion_eso_centro_pct) - Number(r.titulacion_eso_cm_pct));

// 4 · Promoción en 1.º y 2.º ESO
const promocion = leerCsv('f008_promocion_2eso_serie.csv');
const ultimaPromo = promocion[promocion.length - 1];
const anteriorPromo = promocion[promocion.length - 2];

// 5 · 2.º ESO por grupos
const negativa = leerCsv('f008_evaluacion_negativa_por_grupo.csv');
const medias = leerCsv('f008_medias_por_grupo.csv');
const grupos = [...new Set(negativa.map((r) => r.grupo))];
const valor = (tabla: Record<string, string>[], grupo: string, evaluacion: string, campo: string) =>
  num(tabla.find((r) => r.grupo === grupo && r.evaluacion === evaluacion)?.[campo] ?? '');
const negFinal = grupos.map((g) => valor(negativa, g, 'final', 'pct_evaluados_negativamente') as number);
const etiquetaGrupo = (g: string) => g.replace(/^2/, '2.º ');

// 1b · % de aptos: el que publica el centro y el que da la CM para el centro (F012)
const aptosOficial = leerCsv('f012_pau_centro_oficial_vs_publicado.csv');
const difAptos = aptosOficial.map((r) => Number(r.dif_publicado_menos_oficial_pp));

// 1c · Titulación en Bachillerato. Oficial (F012, todas las convocatorias) hasta
// 2023-24; después solo existe la de la convocatoria ordinaria que publica el
// centro (F002/F003). Son indicadores distintos: series separadas.
const titBach = leerCsv('f012_titulacion_bachillerato.csv');
const cursosTitBach = [...titBach.map((r) => r.curso_academico), ...brecha.map((r) => r.curso_academico)];
const titBachUlt = titBach[titBach.length - 1];

// 1d · Nota de Bachillerato frente a nota de la PAU, según el centro (F002 p. 5 y F003)
const expediente = leerCsv('f002_notas_expediente_pau.csv');
const conExpediente = expediente.filter((r) => r.media_expediente_bach !== '');
const difExp = conExpediente.map((r) => Number(r.media_expediente_bach) - Number(r.media_pau_fase_general));
const cursosExpMayor = difExp.filter((d) => d > 0).length;

// 1e · Reparto de Bachillerato entre 1.º y 2.º: con la matrícula de la etapa (F011)
// y el mínimo de 2.º del bloque 1, 1.º tiene como mucho el resto.
const matricula = leerCsv('f011_matricula_por_etapa.csv');
const piramide = brecha.map((r, i) => {
  const total = Number(matricula.find((m) => m.curso_academico === r.curso_academico)?.bachillerato);
  return { curso: r.curso_academico, total, segundoMin: acceso[i].alumnosMin, primeroMax: total - acceso[i].alumnosMin };
});
const pirUlt = piramide[piramide.length - 1];

// 1f · Solicitudes de plaza (F012)
const admision = leerCsv('f012_admision_solicitudes.csv');
const admBach = admision.filter((r) => r.etapa === 'Bachillerato');
const admEso = admision.filter((r) => r.etapa === 'ESO');

// 4b · Qué pasa con el alumnado de 2.º ESO en 2025-26 (F008 p. 27)
const agregado = leerCsv('f008_no_promocion_agregado_2025-26.csv')[0];
const promo2 = {
  total: Number(agregado.total_alumnos),
  sinPendientes: Number(agregado.promocionan) - Number(agregado.con_1_2_pendientes),
  conPendientes: Number(agregado.con_1_2_pendientes),
  noPromocionan: Number(agregado.total_alumnos) - Number(agregado.promocionan),
};

// 4c · Idoneidad (repetición acumulada), 2023-24 (F013)
const idoneidad = leerCsv('f013_idoneidad_eso_cm_oeste_torrelodones.csv');
const edades = ['12', '13', '14', '15'];
const idoUlt = idoneidad.filter((r) => r.curso_academico === '2023-24');
const idoDe = (ambito: string) => idoUlt.find((r) => r.ambito === ambito)!;
const ambitosIdo = [
  { ambito: 'Torrelodones (municipio)', nombre: 'Torrelodones (todos los centros)', color: CENTRO },
  { ambito: 'DAT Madrid-Oeste', nombre: 'DAT Madrid-Oeste', color: GRIS_OSCURO, discontinua: true },
  { ambito: 'Comunidad de Madrid', nombre: 'Comunidad de Madrid', color: CM },
];

// 5b · Suspensos por materia y grupo en la evaluación final (F008 pp. 21-26)
const materias = leerCsv('f008_final_materias_y_composicion_2eso.csv');
const columnasMaterias = [
  { campo: 'in_lengua', nombre: 'Lengua' },
  { campo: 'in_matematicas', nombre: 'Matemát.' },
  { campo: 'in_geografia_historia', nombre: 'Geo. e Hist.' },
  { campo: 'in_ingles', nombre: 'Inglés' },
  { campo: 'in_fisica_quimica', nombre: 'Fís. y Quím.' },
  { campo: 'in_tecnologia', nombre: 'Tecnología' },
];
const pctMateria = (r: Record<string, string>, campo: string) => (100 * Number(r[campo])) / Number(r.total_alumnos);
const alumnosActas = materias.reduce((a, r) => a + Number(r.total_alumnos), 0);
const conSuspensaFinal = materias.reduce((a, r) => a + Number(r.evaluados_negativamente), 0);
---

<Base
  title="Datos"
  description="Datos públicos del IES Diego Velázquez (PAU, titulación y promoción), con enlace a cada fuente para poder comprobarlos."
>
  <section class="container intro">
    <h1>Los datos del instituto</h1>
    <p class="intro__lead">
      Cifras del IES Diego Velázquez explicadas con calma. Cada gráfico enlaza a su fuente original para que
      cualquiera pueda comprobarla, y los datos se pueden descargar.
    </p>
    <ul class="intro__claves">
      <li><strong>Fuente siempre visible</strong> debajo de cada gráfico, con la página exacta.</li>
      <li>
        <span class="etiqueta-mini">Estimación</span> marca las cifras calculadas por nosotros cuando no hay dato
        oficial. Se dibujan rayadas.
      </li>
      <li>
        <span class="alerta-mini" aria-hidden="true">!</span> marca discrepancias o datos que merecen un análisis
        más detenido.
      </li>
      <li>
        ¿Ves un error o se te ocurre qué más investigar? <a href="#propuestas">Proponlo</a> o escríbenos a <a href="mailto:familias.diego.velazquez@gmail.com">familias.diego.velazquez@gmail.com</a> y lo
        corregimos.
      </li>
    </ul>
    <nav class="indice" aria-label="Secciones">
      <a href="#bachillerato">Bachillerato y PAU</a>
      <a href="#eso">Promoción y repetición en la ESO</a>
      <a href="#grupos">2.º de ESO, grupo a grupo</a>
      <a href="#pendiente">Datos que faltan</a>
      <a href="#propuestas">Propón qué investigar</a>
    </nav>
  </section>

  <section class="container seccion" id="bachillerato" aria-labelledby="bachillerato-h">
    <h2 id="bachillerato-h">Bachillerato y PAU</h2>
    <p class="seccion__intro">
      El centro publica cada año sus resultados en la PAU. Aquí se ponen al lado de las cifras oficiales de la
      Comunidad de Madrid y de otros datos del mismo curso: quién titula, quién se presenta y cuántos alumnos hay.
    </p>

    <div class="rejilla">
      <BloqueDato
        id="quien-llega"
        alerta={`El ${pct(acceso[1].aprobadosPct)} de aprobados que publica el centro deja fuera al menos a ${acceso[1].noTitulan} alumnos que no titularon en junio. Sobre el total de 2.º de Bachillerato, aprobó como mucho el ${pct(acceso[1].aprobadosSobreTotalMax)}.`}
        titulo="¿Quién llega a la PAU?"
        cifra={`≥ ${acceso[1].noTitulan}`}
        cifraTexto={`alumnos de 2.º de Bachillerato no titularon en junio de 2026 y no podían presentarse a la PAU (≥ ${acceso[0].noTitulan} en 2025)`}
        descripcion={`Para presentarse a la PAU hay que tener el título de Bachiller. Por eso el ${pct(acceso[1].aprobadosPct)} de aprobados que publica el centro para 2026 se calcula solo sobre quienes titularon en junio y se presentaron. Sobre el total del alumnado de 2.º de Bachillerato, aprobó la PAU como mucho el ${pct(acceso[1].aprobadosSobreTotalMax)} (${pct(acceso[0].aprobadosSobreTotalMax)} en 2025).`}
        pregunta="¿Qué ocurre con el alumnado que no titula en junio y no puede presentarse a la PAU?"
        leyenda={[
          { nombre: 'No titulan en junio: no pueden presentarse (mínimo)', color: GRIS, estimada: true },
          { nombre: 'Se presentan y no aprueban', color: CENTRO_CLARO },
          { nombre: 'Aprueban la PAU', color: CENTRO },
        ]}
        notas={[
          `Cómo se calcula, solo con las cifras del centro: en 2026 tituló el ${pct(acceso[1].tituladosPct, 2)} y se presentaron ${acceso[1].presentados}. Como todos los presentados tenían que estar titulados, en 2.º había al menos ${acceso[1].presentados} ÷ ${dec(acceso[1].tituladosPct / 100, 4)} = ${acceso[1].alumnosMin} alumnos, y al menos ${acceso[1].alumnosMin} − ${acceso[1].presentados} = ${acceso[1].noTitulan} no titularon. Es un mínimo: si algún titulado no se presentó, la cifra real es mayor.`,
          'Por la misma razón, la proporción que se presenta nunca puede superar la de titulados: como mucho el 64,25 % en 2026 y el 81,4 % en 2025.',
          'Supone que los presentados que da el centro son alumnos del propio curso en la convocatoria de junio.',
          'Quien titula en la evaluación extraordinaria puede presentarse a la PAU extraordinaria de julio. El centro no publica esos resultados en sus carteles.',
          'Para 2025 el centro da un 95,9 % de aprobados en su resumen y un 95,8 % en su gráfico histórico. Aquí se usa el del resumen.',
        ]}
        citas={[
          { fuente: 'F002', pagina: '2', dato: 'PAU 2025: titulados, presentados y aprobados' },
          { fuente: 'F003', dato: 'PAU 2026: titulados, presentados y aprobados' },
          { fuente: 'RD534', pagina: '10', dato: 'Requisito del título de Bachiller (art. 10.1)' },
        ]}
        csv={['brecha_titulacion_pau.csv']}
      >
        <Apiladas
          id="g-quien-llega"
          titulo="Alumnado de 2.º de Bachillerato según si titula en junio, se presenta y aprueba la PAU, 2025 y 2026"
          categorias={acceso.map((a) => a.convocatoria)}
          tramos={[
            { nombre: 'No titulan en junio', color: GRIS, minimo: true },
            { nombre: 'Se presentan y no aprueban', color: CENTRO_CLARO },
            { nombre: 'Aprueban', color: CENTRO },
          ]}
          valores={acceso.map((a) => [a.noTitulan, a.presentados - a.aprobados, a.aprobados])}
        />
        <table slot="tabla">
          <thead>
            <tr>
              <th>Convocatoria</th><th>Titulan (ord.)</th><th>Presentados</th><th>Aprueban (de los presentados)</th>
              <th>Alumnos de 2.º (mínimo)</th><th>No titulan (mínimo)</th><th>Aprueban sobre el total (máximo)</th>
            </tr>
          </thead>
          <tbody>
            {acceso.map((a) => (
              <tr>
                <td>{a.convocatoria}</td>
                <td>{pct(a.tituladosPct, 2)}</td>
                <td>{a.presentados}</td>
                <td>{pct(a.aprobadosPct)} ({a.aprobados})</td>
                <td>≥ {a.alumnosMin}</td>
                <td>≥ {a.noTitulan}</td>
                <td>≤ {pct(a.aprobadosSobreTotalMax)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </BloqueDato>

      <BloqueDato
        id="aptos-oficial"
        alerta={`En los ${aptosOficial.length} cursos con dato oficial, el porcentaje de aptos que publica el centro es más alto que el que la Comunidad de Madrid da para el mismo centro: entre ${dec(Math.min(...difAptos), 2)} y ${dec(Math.max(...difAptos), 2)} puntos más.`}
        titulo="Aptos en la PAU: la cifra del centro y la oficial"
        cifra={`${pct(Number(aptosOficial[aptosOficial.length - 1].pct_aptos_centro_publicado), 2)} / ${pct(Number(aptosOficial[aptosOficial.length - 1].pct_aptos_centro_cm), 2)}`}
        cifraTexto={`aptos del centro en ${aptosOficial[aptosOficial.length - 1].curso_academico}: el que publica el centro y el que da la Comunidad de Madrid`}
        descripcion="El buscador de centros de la Comunidad de Madrid da, para cada centro, el número de presentados a la PAU y el porcentaje de aptos. Para los mismos cursos, la cifra que publica el centro siempre es más alta."
        pregunta="¿Qué convocatorias y qué alumnos cuenta cada una de las dos cifras?"
        leyenda={[
          { nombre: 'Según el centro (discontinua)', color: CENTRO_CLARO },
          { nombre: 'Según la Comunidad de Madrid', color: CENTRO },
        ]}
        notas={[
          'El eje empieza en el 90 %, no en el 0 %, para que se vean las diferencias.',
          'Una explicación posible, sin confirmar: que el centro cuente solo la convocatoria de junio y la Comunidad de Madrid, también la extraordinaria. Ninguna de las dos fuentes lo aclara.',
          'El buscador también da una media regional, pero no la usamos: para 2019-20 da un 100 % y para 2020-21 un 66,67 %, cifras incompatibles con las oficiales de la PAU (91,50 % y 94,49 %).',
        ]}
        citas={[
          { fuente: 'F012', dato: 'Presentados y % de aptos del centro según la Comunidad de Madrid' },
          { fuente: 'F002', pagina: '4', dato: '% de aptos que publica el centro' },
        ]}
        csv={['f012_pau_centro_oficial_vs_publicado.csv']}
      >
        <Lineas
          id="g-aptos-oficial"
          titulo="Porcentaje de aptos del IES Diego Velázquez en la PAU: el que publica el centro y el que da la Comunidad de Madrid, 2019-20 a 2023-24"
          categorias={aptosOficial.map((r) => corto(r.curso_academico))}
          series={[
            { nombre: 'Según el centro', color: CENTRO_CLARO, discontinua: true, valores: aptosOficial.map((r) => Number(r.pct_aptos_centro_publicado)) },
            { nombre: 'Según la CM', color: CENTRO, valores: aptosOficial.map((r) => Number(r.pct_aptos_centro_cm)) },
          ]}
          min={90}
          max={100}
          marcas={[90, 92, 94, 96, 98, 100]}
          formato={(v) => pct(v, 2)}
        />
        <table slot="tabla">
          <thead>
            <tr><th>Curso</th><th>Presentados (CM)</th><th>Aptos según el centro</th><th>Aptos según la CM</th><th>Diferencia</th></tr>
          </thead>
          <tbody>
            {aptosOficial.map((r) => (
              <tr>
                <td>{r.curso_academico}</td>
                <td>{r.presentados_pau_cm}</td>
                <td>{pct(Number(r.pct_aptos_centro_publicado), 2)}</td>
                <td>{pct(Number(r.pct_aptos_centro_cm), 2)}</td>
                <td>+{dec(Number(r.dif_publicado_menos_oficial_pp), 2)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </BloqueDato>

      <BloqueDato
        id="serie-aptos"
        alerta={'Para 2024-25 el centro publica una media regional del 95,5 %, pero la oficial es del 95,16 %. Y para sí mismo da dos cifras distintas: 95,9 % y 95,8 %.'}
        titulo="Aptos en la PAU: el centro y la Comunidad de Madrid"
        cifra={`${dec(Math.min(...difs))}–${dec(Math.max(...difs))}`}
        cifraTexto="puntos por encima de la media regional, según el curso"
        descripcion={`Entre ${serie[0].curso_academico} y ${serie[serie.length - 1].curso_academico} el porcentaje de aptos del centro ha estado todos los cursos por encima de la media de la Comunidad de Madrid.`}
        pregunta="¿Cómo ha evolucionado el centro respecto a la media regional?"
        leyenda={[
          { nombre: 'IES Diego Velázquez', color: CENTRO },
          { nombre: 'Com. de Madrid, según el centro (hasta 2017-18, discontinua)', color: CM },
          { nombre: 'Comunidad de Madrid, oficial (desde 2018-19)', color: CM },
        ]}
        notas={[
          'El eje empieza en el 90 %, no en el 0 %, para que se vean las diferencias.',
          'Media regional: hasta 2017-18, la que publica el centro, que no hemos podido comprobar (línea discontinua); desde 2018-19, la oficial de la Comunidad de Madrid (aptos respecto a matriculados en la PAU). Las dos veces que hemos podido comparar, la media regional que da el centro era más alta que la oficial.',
          'La Comunidad de Madrid también da, para 2026, un 95,1 % de aptos respecto a presentados. Si el centro calcula sobre presentados, la diferencia comparable en 2025-26 es de 2,0 puntos, no de 2,37.',
          'En 2024-25 el centro publica una media regional del 95,5 %; la Comunidad de Madrid, del 95,16 %. Aquí se usa la oficial.',
          'El centro no indica si su porcentaje se calcula sobre los matriculados o sobre los presentados a la PAU.',
        ]}
        citas={[
          { fuente: 'F002', pagina: '4', dato: 'Centro 2013-14 a 2024-25 y media regional hasta 2017-18' },
          { fuente: 'F003', dato: 'Centro 2025-26' },
          { fuente: 'F009', pagina: '5', dato: 'Media regional desde 2018-19' },
        ]}
        csv={['serie_historica_aptos.csv']}
      >
        <Lineas
          id="g-serie-aptos"
          titulo="Porcentaje de aptos en la PAU por curso, IES Diego Velázquez frente a Comunidad de Madrid"
          categorias={serie.map((r) => corto(r.curso_academico))}
          series={[
            { nombre: 'IES Diego Velázquez', color: CENTRO, valores: serie.map((r) => Number(r.pct_aptos_diego_velazquez)) },
            { nombre: 'Com. de Madrid (según el centro)', color: CM, discontinua: true, etiquetar: false, valores: serie.map((r, i) => (i <= ultimoCmCentro ? Number(r.pct_aptos_comunidad_madrid) : null)) },
            { nombre: 'Comunidad de Madrid (oficial)', color: CM, valores: serie.map((r, i) => (i > ultimoCmCentro ? Number(r.pct_aptos_comunidad_madrid) : null)) },
          ]}
          min={90}
          max={100}
          marcas={[90, 92, 94, 96, 98, 100]}
          formato={(v) => pct(v, 2)}
        />
        <table slot="tabla">
          <thead>
            <tr><th>Curso</th><th>Centro</th><th>Com. de Madrid</th><th>Diferencia</th></tr>
          </thead>
          <tbody>
            {serie.map((r) => (
              <tr>
                <td>{r.curso_academico}</td>
                <td>{pct(Number(r.pct_aptos_diego_velazquez), 2)}</td>
                <td>{pct(Number(r.pct_aptos_comunidad_madrid), 2)}</td>
                <td>{dec(Number(r.brecha_pp), 2)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </BloqueDato>

      <BloqueDato
        id="nota-pau"
        titulo="Nota media en la PAU: la que publica el centro y la oficial"
        alerta={`Según la Comunidad de Madrid, la nota media del centro en la PAU es entre ${dec(Math.min(...difNota), 2)} y ${dec(Math.max(...difNota), 2)} puntos más baja que la que publica el propio centro, todos los cursos.`}
        cifra={`${dec(Number(notaUlt.pau_media_fase_general_segun_centro_f002), 2)} / ${dec(Number(notaUlt.pau_nota_media_centro), 2)}`}
        cifraTexto={`nota del centro en ${notaUlt.curso_academico}: la que publica el centro y la que da la Comunidad de Madrid`}
        descripcion={`Para los mismos cursos, la nota que el centro presenta como «media de la fase general» es más alta que la que la Comunidad de Madrid da para el centro en su buscador. Según la cifra oficial, el centro supera la media regional en ${cursosNotaSobreCm} de los ${resultadosCm.length} cursos.`}
        pregunta="¿Miden lo mismo las dos cifras? Si no, ¿qué mide cada una?"
        leyenda={[
          { nombre: 'Centro, según el centro', color: CENTRO_CLARO },
