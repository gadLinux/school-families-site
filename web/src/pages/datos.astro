          categorias={resultadosCm.map((r) => corto(r.curso_academico))}
          series={[
            { nombre: 'IES Diego Velázquez', color: CENTRO, valores: resultadosCm.map((r) => Number(r.titulacion_eso_centro_pct)) },
            { nombre: 'Comunidad de Madrid', color: CM, valores: resultadosCm.map((r) => Number(r.titulacion_eso_cm_pct)) },
